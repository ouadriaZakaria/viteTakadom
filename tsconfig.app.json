{
    "extends": "./tsconfig.json",
    "compilerOptions": {
      "outDir": "./dist",
      "noEmit": true,
      "module": "ESNext",
      "target": "ESNext",
      "lib": ["ESNext", "DOM"],
      "jsx": "react-jsx",
      "baseUrl": ".",
      "paths": {
        "@/*": [
          "./src/*"
        ]
      }
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist", "test", "**/*.test.ts", "**/*.spec.ts"]
  }
  